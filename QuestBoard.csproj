<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <DuckovPath>D:\Steam\steamapps\common\Escape from Duckov</DuckovPath>
        <LangVersion>default</LangVersion>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="ModBehaviour.cs" />
        <Compile Include="Localization.cs" />
        <Compile Include="QuestViewPatches.cs" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\TeamSoda.*" />
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\ItemStatsSystem.dll" />
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\Unity*" />
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\LeTai*" />
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\UniTask*" />
        <Reference Include="$(DuckovPath)\Duckov_Data\Managed\Eflatun.SceneReference.dll" />
        <Reference Include="0Harmony">
            <HintPath>0Harmony.dll</HintPath>
        </Reference>
    </ItemGroup>
    <Target Name="CopyModFiles" AfterTargets="Build">
        <ItemGroup>
            <ModFiles Include="$(TargetDir)QuestBoard.dll" />
            <ModFiles Include="$(TargetDir)QuestBoard.pdb" />
            <ModFiles Include="info.ini" />
        </ItemGroup>
        <Copy SourceFiles="@(ModFiles)"
              DestinationFolder="$(DuckovPath)\Duckov_Data\Mods\QuestBoard"
              SkipUnchangedFiles="false" />
        <Message Text="Mod files copied to game Mods folder." Importance="high" />
    </Target>
</Project>
